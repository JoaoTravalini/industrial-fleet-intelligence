# Industrial Fleet Intelligence Platform environment template
# Copy this file to .env for local development and keep .env uncommitted.
# Use only local, non-paid services. Do not add paid API keys or real secrets.

# Application runtime placeholders
# APP_ENV=<local-environment-name>
# API_HOST=<local-api-host>
# API_PORT=<local-api-port>
# WEB_PORT=<local-web-port>

# Planned PostgreSQL placeholders
# POSTGRES_HOST=<local-postgres-host>
# POSTGRES_PORT=<local-postgres-port>
# POSTGRES_DB=<local-database-name>
# POSTGRES_USER=<local-database-user>
# POSTGRES_PASSWORD=<local-database-password>

# Planned Apache Kafka placeholders
# KAFKA_BOOTSTRAP_SERVERS=<local-kafka-bootstrap-servers>
# KAFKA_TOPIC_TELEMETRY=<local-telemetry-topic-name>

# Planned MLflow placeholders
# MLFLOW_TRACKING_URI=<local-mlflow-tracking-uri>
# MLFLOW_EXPERIMENT_NAME=<local-experiment-name>

# Planned Ollama placeholders
# OLLAMA_BASE_URL=<local-ollama-base-url>
# OLLAMA_MODEL=<local-model-name>
