# Industrial Fleet Intelligence Platform local environment template
# Copy this file to .env for local development and keep .env uncommitted.
# These values are fake local-development examples only.
# Change POSTGRES_PASSWORD in your local .env before using shared or long-lived data.

# PostgreSQL local development
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=industrial_fleet_dev
POSTGRES_USER=industrial_fleet_dev
POSTGRES_PASSWORD=change-me-local-development-only
POSTGRES_PORT=5432

# Apache Kafka local development
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=industrial.telemetry.v1

# FastAPI local development
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Local AI Copilot through Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
COPILOT_TIMEOUT_SECONDS=180
COPILOT_TOTAL_TIMEOUT_SECONDS=240
COPILOT_MAX_TOOL_ROUNDS=2
COPILOT_MAX_HISTORY_MESSAGES=6
COPILOT_KNOWLEDGE_TOP_K=2
COPILOT_OLLAMA_KEEP_ALIVE=10m
COPILOT_NUM_CTX=4096
COPILOT_NUM_PREDICT=160
COPILOT_THINK=false
